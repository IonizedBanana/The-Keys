<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hurricane.HomeController">
   <top>
      <fx:include source="nav.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true">
         <content>
            <VBox spacing="24.0">
               <padding>
                  <Insets bottom="40.0" left="48.0" right="48.0" top="32.0" />
               </padding>
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label fx:id="greetingLabel" styleClass="h1" />
                        <Label fx:id="locationLabel" styleClass="text-secondary" />
                     </children>
                  </VBox>

                  <VBox fx:id="alertBanner" spacing="4.0" styleClass="alert-banner">
                     <children>
                        <Label fx:id="alertTitle" styleClass="alert-title" />
                        <Label fx:id="alertBody" wrapText="true" />
                     </children>
                  </VBox>

                  <HBox spacing="20.0">
                     <children>
                        <VBox spacing="16.0" styleClass="card" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label text="Current Storm" styleClass="h3" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="stormStatusTag" styleClass="tag" />
                                 </children>
                              </HBox>
                              <Label fx:id="stormNameLabel" styleClass="h2" />
                              <HBox fx:id="stormStats" spacing="12.0">
                                 <children>
                                    <VBox spacing="4.0" styleClass="stat" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label text="Category" styleClass="caption" />
                                          <Label fx:id="categoryLabel" styleClass="h3" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="4.0" styleClass="stat" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label text="Status" styleClass="caption" />
                                          <Label fx:id="statusLabel" styleClass="h3" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="4.0" styleClass="stat" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label text="Location" styleClass="caption" />
                                          <Label fx:id="stormLocationLabel" styleClass="h3" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <VBox spacing="8.0" styleClass="card" prefWidth="400.0" minWidth="340.0">
                           <children>
                              <Label text="Nearby Shelters" styleClass="h3" />
                              <VBox fx:id="shelterList" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
