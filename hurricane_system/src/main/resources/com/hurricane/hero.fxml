<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Branded left panel shared by the landing, login and sign-up screens -->
<BorderPane styleClass="hero" prefWidth="520.0" minWidth="420.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <VBox alignment="CENTER_LEFT" spacing="32.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <fx:include source="logo-mark.fxml" />
                  <Label text="SafeKey" styleClass="logo-text" />
               </children>
            </HBox>
            <VBox spacing="14.0">
               <children>
                  <Label text="Get help when&#10;the storm hits." styleClass="display" wrapText="true" />
                  <Label text="Request rescue, transport and supplies, find open shelters, and follow your request until help arrives." styleClass="body-large, text-secondary" wrapText="true" />
               </children>
            </VBox>
            <VBox spacing="12.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label text="✓" styleClass="feature-check" />
                        <Label text="Request help in under a minute" styleClass="body-large" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label text="✓" styleClass="feature-check" />
                        <Label text="See open shelters near you" styleClass="body-large" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label text="✓" styleClass="feature-check" />
                        <Label text="Track volunteers in real time" styleClass="body-large" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <Label text="⚠  In a life-threatening emergency, always call 911." styleClass="text-warning" BorderPane.alignment="CENTER_LEFT">
         <BorderPane.margin>
            <Insets bottom="48.0" />
         </BorderPane.margin>
      </Label>
   </bottom>
</BorderPane>
