<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hurricane.LandingController">
   <children>
      <fx:include source="hero.fxml" />
      <StackPane HBox.hgrow="ALWAYS">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="28.0" maxWidth="380.0" maxHeight="-Infinity">
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Welcome to SafeKey" styleClass="h1" />
                        <Label text="Sign in to request help, find shelters, and check on your requests." styleClass="text-secondary" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="12.0">
                     <children>
                        <Button text="Sign In" defaultButton="true" maxWidth="Infinity" onAction="#switchToLogin" />
                        <Button text="Create an Account" styleClass="secondary" maxWidth="Infinity" onAction="#switchToSignUp" />
                     </children>
                  </VBox>
                  <Label text="Hurricane relief across the United States" styleClass="caption" maxWidth="Infinity" alignment="CENTER" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</HBox>
