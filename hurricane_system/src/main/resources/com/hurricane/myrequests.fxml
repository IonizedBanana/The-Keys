<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.MyRequestsController">
   <top>
      <fx:include fx:id="nav" source="nav.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true">
         <content>
            <VBox spacing="24.0">
               <padding>
                  <Insets bottom="40.0" left="48.0" right="48.0" top="32.0" />
               </padding>
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label text="My Requests" styleClass="h1" />
                        <Label fx:id="subtitleLabel" styleClass="text-secondary" wrapText="true" />
                     </children>
                  </VBox>

                  <!-- same order as the prototype: completed on the left, open on the right -->
                  <HBox spacing="20.0">
                     <children>
                        <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="400.0">
                           <children>
                              <Label text="Completed Requests" styleClass="h3" />
                              <VBox fx:id="completedList" />
                           </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="400.0">
                           <children>
                              <Label text="Open Requests" styleClass="h3" />
                              <VBox fx:id="openList" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
