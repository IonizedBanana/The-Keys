<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<!-- Top navigation bar shared by every screen after login -->
<HBox styleClass="top-nav" alignment="CENTER_LEFT" spacing="40.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.NavController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <fx:include source="logo-mark.fxml" />
            <Label text="SafeKey" styleClass="logo-text" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="24.0">
         <children>
            <Button fx:id="homeLink" text="Home" styleClass="nav-link" onAction="#goHome" />
            <!-- TODO hook these up once the shelters and my requests screens exist -->
            <Button fx:id="sheltersLink" text="Shelters" styleClass="nav-link" />
            <Button fx:id="requestsLink" text="My Requests" styleClass="nav-link" />
         </children>
      </HBox>
      <Region HBox.hgrow="ALWAYS" />
      <HBox alignment="CENTER_LEFT" spacing="16.0">
         <children>
            <Label fx:id="stormTag" styleClass="tag, tag-warning" />
            <Button fx:id="newRequestButton" text="New Request" styleClass="small" onAction="#goNewRequest" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label fx:id="initialsLabel" styleClass="avatar" />
                  <Label fx:id="nameLabel" />
               </children>
            </HBox>
            <Button text="Log Out" styleClass="secondary, small" onAction="#logout" />
         </children>
      </HBox>
   </children>
</HBox>
