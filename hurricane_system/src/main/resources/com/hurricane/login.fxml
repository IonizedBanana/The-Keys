<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hurricane.LoginController">
   <children>
      <fx:include source="hero.fxml" />
      <StackPane HBox.hgrow="ALWAYS">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="28.0" maxWidth="380.0" maxHeight="-Infinity">
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Welcome back" styleClass="h1" />
                        <Label text="Sign in to your SafeKey account." styleClass="text-secondary" />
                     </children>
                  </VBox>
                  <VBox spacing="14.0">
                     <children>
                        <VBox spacing="6.0">
                           <children>
                              <Label text="Username" styleClass="field-label" />
                              <TextField fx:id="usernameField" promptText="Enter your username" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label text="Password" styleClass="field-label" />
                              <PasswordField fx:id="passwordField" promptText="Enter your password" onAction="#login" />
                           </children>
                        </VBox>
                        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="16.0">
                     <children>
                        <Button text="Sign In" defaultButton="true" maxWidth="Infinity" onAction="#login" />
                        <HBox alignment="CENTER" spacing="6.0">
                           <children>
                              <Label text="Don't have an account?" styleClass="text-secondary" />
                              <Hyperlink text="Create one" onAction="#switchToSignUp" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</HBox>
