<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Icons are Lucide (ISC license) paths, matching documents/icons -->
<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hurricane.LoginController">
   <children>
      <VBox fx:id="card" styleClass="card" alignment="CENTER" spacing="12.0" maxWidth="380.0" maxHeight="-Infinity">
         <children>
            <!-- life-buoy -->
            <StackPane styleClass="brand-badge">
               <Group>
                  <SVGPath styleClass="icon" scaleX="1.6" scaleY="1.6" content="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0 M4.93 4.93l4.24 4.24 M14.83 9.17l4.24-4.24 M14.83 14.83l4.24 4.24 M9.17 14.83l-4.24 4.24 M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
               </Group>
            </StackPane>
            <Label styleClass="title" text="Welcome back" />
            <Label styleClass="subtitle" text="Log in to The Keys Hurricane Relief App" />

            <!-- at-sign -->
            <StackPane alignment="CENTER_LEFT">
               <VBox.margin><Insets top="8.0" /></VBox.margin>
               <TextField fx:id="usernameField" promptText="Username" />
               <Group mouseTransparent="true" translateX="12.0">
                  <SVGPath styleClass="icon, field-icon" scaleX="0.75" scaleY="0.75" content="M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8" />
               </Group>
            </StackPane>
            <!-- lock -->
            <StackPane alignment="CENTER_LEFT">
               <PasswordField fx:id="passwordField" promptText="Password" onAction="#login" />
               <Group mouseTransparent="true" translateX="12.0">
                  <SVGPath styleClass="icon, field-icon" scaleX="0.75" scaleY="0.75" content="M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z M7 11V7a5 5 0 0 1 10 0v4" />
               </Group>
            </StackPane>

            <Label fx:id="errorLabel" styleClass="error-banner" wrapText="true" graphicTextGap="8.0" maxWidth="Infinity" managed="false" visible="false">
               <graphic>
                  <!-- circle-alert -->
                  <Group>
                     <SVGPath styleClass="icon" scaleX="0.75" scaleY="0.75" content="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0 M12 8v4 M12 16h.01" />
                  </Group>
               </graphic>
            </Label>
            <Button text="Log In" defaultButton="true" maxWidth="Infinity" onAction="#login" />
            <Hyperlink text="Don't have an account? Sign up" onAction="#switchToSignUp" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
</StackPane>
