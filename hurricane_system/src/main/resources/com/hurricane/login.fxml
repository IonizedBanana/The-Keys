<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" maxWidth="320.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hurricane.LoginController">
   <children>
      <Label text="Log In" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
      <TextField fx:id="usernameField" promptText="Username" maxWidth="280.0" />
      <PasswordField fx:id="passwordField" promptText="Password" maxWidth="280.0" onAction="#login" />
      <Label fx:id="errorLabel" textFill="#c62828" wrapText="true" maxWidth="280.0" />
      <Button text="Log In" defaultButton="true" maxWidth="280.0" onAction="#login" />
      <Hyperlink text="Don't have an account? Sign up" onAction="#switchToSignUp" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
