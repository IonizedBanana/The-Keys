<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Icons are Lucide (ISC license) paths, matching documents/icons -->
<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hurricane.SignUpController">
   <children>
      <VBox fx:id="card" styleClass="card" alignment="CENTER" spacing="10.0" maxWidth="420.0" maxHeight="-Infinity">
         <children>
            <Label styleClass="title" text="Create an account" />
            <Label styleClass="subtitle" text="Request or offer help during a hurricane" />

            <!-- user-round -->
            <HBox spacing="10.0">
               <VBox.margin><Insets top="8.0" /></VBox.margin>
               <StackPane alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                  <TextField fx:id="firstNameField" promptText="First name" />
                  <Group mouseTransparent="true" translateX="12.0">
                     <SVGPath styleClass="icon, field-icon" scaleX="0.75" scaleY="0.75" content="M7 8a5 5 0 1 0 10 0a5 5 0 1 0 -10 0 M20 21a8 8 0 0 0-16 0" />
                  </Group>
               </StackPane>
               <StackPane alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                  <TextField fx:id="lastNameField" promptText="Last name" />
                  <Group mouseTransparent="true" translateX="12.0">
                     <SVGPath styleClass="icon, field-icon" scaleX="0.75" scaleY="0.75" content="M7 8a5 5 0 1 0 10 0a5 5 0 1 0 -10 0 M20 21a8 8 0 0 0-16 0" />
                  </Group>
               </StackPane>
            </HBox>
            <!-- at-sign -->
            <StackPane alignment="CENTER_LEFT">
               <TextField fx:id="usernameField" promptText="Username" />
               <Group mouseTransparent="true" translateX="12.0">
                  <SVGPath styleClass="icon, field-icon" scaleX="0.75" scaleY="0.75" content="M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8" />
               </Group>
            </StackPane>
            <!-- mail -->
            <StackPane alignment="CENTER_LEFT">
               <TextField fx:id="emailField" promptText="Email address" />
               <Group mouseTransparent="true" translateX="12.0">
                  <SVGPath styleClass="icon, field-icon" scaleX="0.75" scaleY="0.75" content="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M22 7l-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
               </Group>
            </StackPane>
            <!-- lock -->
            <StackPane alignment="CENTER_LEFT">
               <PasswordField fx:id="passwordField" promptText="Password" />
               <Group mouseTransparent="true" translateX="12.0">
                  <SVGPath styleClass="icon, field-icon" scaleX="0.75" scaleY="0.75" content="M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z M7 11V7a5 5 0 0 1 10 0v4" />
               </Group>
            </StackPane>
            <!-- shield-check -->
            <StackPane alignment="CENTER_LEFT">
               <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" onAction="#signUp" />
               <Group mouseTransparent="true" translateX="12.0">
                  <SVGPath styleClass="icon, field-icon" scaleX="0.75" scaleY="0.75" content="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z M9 12l2 2 4-4" />
               </Group>
            </StackPane>

            <Label fx:id="errorLabel" styleClass="error-banner" wrapText="true" graphicTextGap="8.0" maxWidth="Infinity" managed="false" visible="false">
               <graphic>
                  <!-- circle-alert -->
                  <Group>
                     <SVGPath styleClass="icon" scaleX="0.75" scaleY="0.75" content="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0 M12 8v4 M12 16h.01" />
                  </Group>
               </graphic>
            </Label>
            <Button text="Create Account" defaultButton="true" maxWidth="Infinity" onAction="#signUp" />
            <Hyperlink text="Already have an account? Log in" onAction="#switchToLogin" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
</StackPane>
