<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hurricane.SignUpController">
   <children>
      <Label text="Sign Up" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
      <TextField fx:id="firstNameField" promptText="First name" maxWidth="280.0" />
      <TextField fx:id="lastNameField" promptText="Last name" maxWidth="280.0" />
      <TextField fx:id="usernameField" promptText="Username" maxWidth="280.0" />
      <TextField fx:id="emailField" promptText="Email address" maxWidth="280.0" />
      <PasswordField fx:id="passwordField" promptText="Password" maxWidth="280.0" />
      <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" maxWidth="280.0" onAction="#signUp" />
      <Label fx:id="errorLabel" textFill="#c62828" wrapText="true" maxWidth="280.0" />
      <Button text="Create Account" defaultButton="true" maxWidth="280.0" onAction="#signUp" />
      <Hyperlink text="Already have an account? Log in" onAction="#switchToLogin" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
