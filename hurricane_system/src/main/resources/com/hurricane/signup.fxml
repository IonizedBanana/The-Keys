<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hurricane.SignUpController">
   <children>
      <fx:include source="hero.fxml" />
      <StackPane HBox.hgrow="ALWAYS">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="24.0" maxWidth="420.0" maxHeight="-Infinity">
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Create your account" styleClass="h1" />
                        <Label text="It takes a minute. We use your details to find help near you." styleClass="text-secondary" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="14.0">
                     <children>
                        <HBox spacing="12.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="First name" styleClass="field-label" />
                                    <TextField fx:id="firstNameField" promptText="Enter first name" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Last name" styleClass="field-label" />
                                    <TextField fx:id="lastNameField" promptText="Enter last name" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label text="Username" styleClass="field-label" />
                              <TextField fx:id="usernameField" promptText="Choose a username" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label text="Email address" styleClass="field-label" />
                              <TextField fx:id="emailField" promptText="you@example.com" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label text="Street address" styleClass="field-label" />
                              <TextField fx:id="streetField" promptText="123 Main St" />
                           </children>
                        </VBox>
                        <HBox spacing="12.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="City" styleClass="field-label" />
                                    <TextField fx:id="cityField" promptText="Enter city" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0" prefWidth="80.0">
                                 <children>
                                    <Label text="State" styleClass="field-label" />
                                    <TextField fx:id="stateField" promptText="SC" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0" prefWidth="100.0">
                                 <children>
                                    <Label text="ZIP" styleClass="field-label" />
                                    <TextField fx:id="zipField" promptText="29201" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox spacing="12.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Password" styleClass="field-label" />
                                    <PasswordField fx:id="passwordField" promptText="Enter password" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Confirm password" styleClass="field-label" />
                                    <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" onAction="#signUp" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="16.0">
                     <children>
                        <Button text="Create Account" defaultButton="true" maxWidth="Infinity" onAction="#signUp" />
                        <HBox alignment="CENTER" spacing="6.0">
                           <children>
                              <Label text="Already have an account?" styleClass="text-secondary" />
                              <Hyperlink text="Sign in" onAction="#switchToLogin" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</HBox>
