<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hurricane.MapController">
   <top>
      <fx:include source="nav.fxml" />
   </top>
   <center>
      <BorderPane>
         <top>
            <VBox alignment="CENTER_LEFT" spacing="5.0">
               <padding>
                  <Insets bottom="12.0" left="48.0" right="48.0" top="24.0" />
               </padding>
               <children>
                  <Label text="Shelter Map" styleClass="h1" />
                  <Label fx:id="closestShelterLabel" text="Closest shelter: Loading..." styleClass="text-secondary" />
               </children>
            </VBox>
         </top>
         <center>
            <WebView fx:id="webView" />
         </center>
      </BorderPane>
   </center>
</BorderPane>
